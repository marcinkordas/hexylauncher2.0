<?xml version="1.0" encoding="utf-8"?>
<!-- Hero card — diagonal gradient (violet → cyan tint) with a thin accent border.
     Recreates the handoff's `linear-gradient(140deg, rgba(accent,0.16) 0%, rgba(accent,0.06) 50%, rgba(cyan,0.05) 100%)`. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <gradient
        android:angle="315"
        android:startColor="#297C5CFC"
        android:centerColor="#0F7C5CFC"
        android:endColor="#0D00D4FF"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/hg_border_accent" />
</shape>
