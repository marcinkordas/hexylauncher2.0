<?xml version="1.0" encoding="utf-8"?>
<!-- App icon badge — diagonal gradient (violet → cyan) with accent border ring. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="13dp" />
    <gradient android:angle="135"
        android:startColor="#617C5CFC"
        android:endColor="#4000D4FF"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/hg_border_accent" />
</shape>
