<?xml version="1.0" encoding="utf-8"?>
<!-- Atmospheric violet glow — radial gradient simulates blur(60px) without runtime cost. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="180"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="#1F7C5CFC"
        android:endColor="#007C5CFC" />
</shape>
