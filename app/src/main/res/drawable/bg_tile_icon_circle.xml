<?xml version="1.0" encoding="utf-8"?>
<!-- Neo-Swiss: monochrome icon container. Subtle ink fill so icons read against white tile.
     No per-tile color tinting in this aesthetic — Swiss rigor is single-accent only. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="6dp" />
    <solid android:color="#0F0A0A0A" />
</shape>
