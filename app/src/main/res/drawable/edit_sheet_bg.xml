<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet bg — bumped to ~70% alpha (#B3) so the launcher grid reads clearly behind.
     The diagonal sheen layer keeps it from looking like a flat colored panel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" />
            <solid android:color="#B30B0B1E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" />
            <gradient
                android:angle="270"
                android:startColor="#10FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
