<?xml version="1.0" encoding="utf-8"?>
<!-- Trendy stadium-pill dock background. Layered: solid surface (alpha applied at runtime
     by DockView.applyTransparency), highlight gradient sheen, hairline outline. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E8FFFFFF" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="#22000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="270"
                android:startColor="#28FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
