<?xml version="1.0" encoding="utf-8"?>
<!-- Edit Mode bottom sheet — HexGrid Redesign v2 (handoff).
     Bottom-anchored sheet with drag handle, header (title + 5 parameters + ✕ close),
     and a 4-tab bar (Shape · Style · Order · More) above the content panels. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Vignette over the launcher grid behind. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#7A040410"
        android:importantForAccessibility="no" />

    <!-- The bottom sheet itself. -->
    <LinearLayout
        android:id="@+id/editSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/edit_sheet_bg"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <!-- Top accent line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:background="@drawable/sheet_accent_line"
            android:importantForAccessibility="no" />

        <!-- Drag handle -->
        <View
            android:id="@+id/dragHandle"
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/drag_handle" />

        <!-- Header: title + subtitle + close (✕) -->
        <LinearLayout
            android:id="@+id/sheetHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/sheetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk"
                    android:text="Shape"
                    android:textColor="@color/hg_text_1"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />
                <TextView
                    android:id="@+id/sheetSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="5 parameters"
                    android:textColor="@color/hg_text_3"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Minimize: collapses panel + header so only the tab bar peeks at the
                 bottom and the user can preview their changes against the live grid. -->
            <ImageView
                android:id="@+id/btnMinimize"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/minimize_btn_bg"
                android:padding="7dp"
                android:src="@drawable/ic_chevron_down_24"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Minimize panel" />

            <FrameLayout
                android:id="@+id/btnDone"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/close_btn_bg"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Exit edit mode">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="✕"
                    android:textColor="@color/hg_close_fg"
                    android:textSize="15sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Hairline below header -->
        <View
            android:id="@+id/sheetHairline"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/hg_hairline" />

        <!-- Content panel container -->
        <FrameLayout
            android:id="@+id/panelContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp" />

        <!-- 4-tab bar at the bottom of the sheet -->
        <LinearLayout
            android:id="@+id/toolbarPill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/tab_bar_container"
            android:orientation="horizontal"
            android:padding="3dp">

            <LinearLayout
                android:id="@+id/btnShape"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/tab_active_bg"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Shape"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_shape_24"
                    android:tint="@color/hg_tab_active_fg"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="SHAPE"
                    android:textColor="@color/hg_tab_active_fg"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/tab_inactive_bg"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Style"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_style_24"
                    android:tint="@color/hg_tab_inactive_fg"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="STYLE"
                    android:textColor="@color/hg_tab_inactive_fg"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnOrder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/tab_inactive_bg"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Order"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_order_24"
                    android:tint="@color/hg_tab_inactive_fg"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ORDER"
                    android:textColor="@color/hg_tab_inactive_fg"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/tab_inactive_bg"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="More"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_more_24"
                    android:tint="@color/hg_tab_inactive_fg"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="MORE"
                    android:textColor="@color/hg_tab_inactive_fg"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />
            </LinearLayout>
        </LinearLayout>

        <!-- Collapse handle still required by EditModeOverlay.kt (kept invisible — close button
             is the dismiss control in this redesign). -->
        <ImageView
            android:id="@+id/btnCollapse"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </LinearLayout>
</FrameLayout>
