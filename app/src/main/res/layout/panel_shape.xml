<?xml version="1.0" encoding="utf-8"?>
<!-- Shape panel — dark sheet content. No own bg/elevation/drag handle (those live on the
     sheet shell now). Sub-section labels with accent left bar per handoff. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Sub-section: GEOMETRY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">
        <View
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:background="@color/hg_accent" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="GEOMETRY"
            android:textColor="#FF5A5A80"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.13" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hex radius"
        android:textColor="@color/hg_text_2"
        android:textSize="13sp" />
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderHexRadius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="50"
        android:valueTo="150"
        android:stepSize="1"
        app:thumbColor="#FFFFFFFF"
        app:thumbRadius="11dp"
        app:trackHeight="6dp"
        app:trackColorActive="@color/hg_accent"
        app:trackColorInactive="@color/hg_track_unfilled"
        app:haloRadius="20dp"
        app:haloColor="#337C5CFC"
        app:tickVisible="true"
        app:tickColorActive="#887C5CFC"
        app:tickColorInactive="#22FFFFFF"
        android:contentDescription="Hex radius" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Icon size"
        android:textColor="@color/hg_text_2"
        android:textSize="13sp" />
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderIconSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0.5"
        android:valueTo="1.5"
        android:stepSize="0.05"
        app:thumbColor="#FFFFFFFF"
        app:thumbRadius="11dp"
        app:trackHeight="6dp"
        app:trackColorActive="@color/hg_accent"
        app:trackColorInactive="@color/hg_track_unfilled"
        app:haloRadius="20dp"
        app:haloColor="#337C5CFC"
        app:tickVisible="true"
        app:tickColorActive="#887C5CFC"
        app:tickColorInactive="#22FFFFFF"
        android:contentDescription="Icon size" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Icon padding"
        android:textColor="@color/hg_text_2"
        android:textSize="13sp" />
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderIconPadding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="20"
        android:stepSize="1"
        app:thumbColor="#FFFFFFFF"
        app:thumbRadius="11dp"
        app:trackHeight="6dp"
        app:trackColorActive="@color/hg_accent"
        app:trackColorInactive="@color/hg_track_unfilled"
        app:haloRadius="20dp"
        app:haloColor="#337C5CFC"
        app:tickVisible="true"
        app:tickColorActive="#887C5CFC"
        app:tickColorInactive="#22FFFFFF"
        android:contentDescription="Icon padding" />

    <!-- Sub-section: DETAIL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="10dp">
        <View
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:background="@color/hg_accent" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="DETAIL"
            android:textColor="#FF5A5A80"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.13" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Outline width"
        android:textColor="@color/hg_text_2"
        android:textSize="13sp" />
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderOutlineWidth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0.5"
        android:valueTo="4.0"
        android:stepSize="0.5"
        app:thumbColor="#FFFFFFFF"
        app:thumbRadius="11dp"
        app:trackHeight="6dp"
        app:trackColorActive="@color/hg_accent"
        app:trackColorInactive="@color/hg_track_unfilled"
        app:haloRadius="20dp"
        app:haloColor="#337C5CFC"
        app:tickVisible="true"
        app:tickColorActive="#887C5CFC"
        app:tickColorInactive="#22FFFFFF"
        android:contentDescription="Outline width" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Corner radius"
        android:textColor="@color/hg_text_2"
        android:textSize="13sp" />
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderCornerRadius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="20"
        android:stepSize="1"
        app:thumbColor="#FFFFFFFF"
        app:thumbRadius="11dp"
        app:trackHeight="6dp"
        app:trackColorActive="@color/hg_accent"
        app:trackColorInactive="@color/hg_track_unfilled"
        app:haloRadius="20dp"
        app:haloColor="#337C5CFC"
        app:tickVisible="true"
        app:tickColorActive="#887C5CFC"
        app:tickColorInactive="#22FFFFFF"
        android:contentDescription="Corner radius" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Hex orientation"
        android:textColor="@color/hg_text_2"
        android:textSize="13sp" />
    <!-- Two side-by-side preview buttons with hex SVG (handoff §Shape Panel orientation picker).
         MaterialButtonToggleGroup keeps single-selection behavior + the `toggleHexOrientation`
         binding ID expected by ShapePanel.kt. -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleHexOrientation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOrientationPointy"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            app:icon="@drawable/ic_hex_pointy_24"
            app:iconSize="36dp"
            app:iconGravity="top"
            app:iconPadding="6dp"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:text="POINTY" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOrientationFlat"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            app:icon="@drawable/ic_hex_flat_24"
            app:iconSize="36dp"
            app:iconGravity="top"
            app:iconPadding="6dp"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:text="FLAT" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

</LinearLayout>
